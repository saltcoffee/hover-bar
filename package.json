{
  "name": "hover-bar",
  "version": "0.1.1",
  "description": "Format selected text with a floating toolbar, text colors, highlights, and internal links.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "gua",
  "repository": {
    "type": "git",
    "url": "https://github.com/saltcoffee/hover-bar.git"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.mjs",
    "test": "vitest run",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:release"
  },
  "dependencies": {
    "entities": "8.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "10.0.1",
    "@lezer/common": "1.5.4",
    "@lezer/markdown": "1.8.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "obsidian": "1.8.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
